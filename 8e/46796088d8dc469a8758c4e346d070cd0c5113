tom: 6px; display: flex; gap: 8px; align-items: center; }\n  .mini .t .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); }\n  .mini p { font-size: 13.5px; color: var(--ink-2); }\n\n  /* 时间线 */\n  .timeline { position: relative; padding-left: 26px; }\n  .timeline::before {\n    content: \"\"; position: absolute; left: 7px; top: 6px; bottom: 6px;\n    width: 2px; background: linear-gradient(var(--blue), var(--teal));\n    border-radius: 2px; opacity: .35;\n  }\n  .tl-item { position: relative; padding: 0 0 22px 8px; }\n  .tl-item:last-child { padding-bottom: 0; }\n  .tl-item::before {\n    content: \"\"; position: absolute; left: -25px; top: 7px;\n    width: 12px; height: 12px; border-radius: 50%;\n    background: var(--card); border: 3px solid var(--blue);\n  }\n  .tl-item:nth-child(2)::before { border-color: var(--teal); }\n  .tl-item:nth-child(3)::before { border-color: var(--orange); }\n  .tl-item:nth-child(4)::before { border-color: var(--red); }\n  .tl-item .t { font-weight: 700; font-size: 15.5px; }\n  .tl-item .d { font-size: 13.5px; color: var(--ink-2); margin-top: 3px; }\n  .tl-item .d b { color: var(--ink); }\n\n  /* 数据条 */\n  .bars { display: flex; flex-direction: column; gap: 12px; margin-top: 6px; }\n  .bar-row { display: grid; grid-template-columns: 150px 1fr 74px; gap: 12px; align-items: center; }\n  .bar-row .name { font-size: 13px; color: var(--ink-2); text-align: right; }\n  .bar-row .track { height: 26px; background: #eef2f9; border-radius: 8px; overflow: hidden; position: relative; }\n  .bar-row .fill {\n    height: 100%; border-radius: 8px; width: 0;\n    transition: width 1s cubic-bezier(.22,.8,.35,1);\n    background: linear-gradient(90deg, #4f7bff, var(--blue));\n  }\n  .bar-row .val { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--ink); }\n  .fill.teal { background: linear-gradient(90deg, #2ec4b6, var(--teal)); }\n  .fill.orange { background: linear-gradient(90deg, #ffb26b, var(--orange)); }\n  .fill.red { background: linear-gradient(90deg, #ff8fb1, var(--red)); }\n  .fill.gray { background: linear-gradient(90deg, #b9c5da, #8fa1bd); }\n\n  /* 对比条（优化前后） */\n  .cmp { display: flex; flex-direction: column; gap: 16px; }\n  .cmp-item .label { font-size: 13px; color: var(--ink-2); margin-bottom: 6px; display: flex; justify-content: space-between; }\n  .cmp-item .label b { color: var(--ink); font-family: var(--mono); }\n  .cmp-track { display: flex; flex-direction: column; gap: 5px; }\n  .cmp-bar { height: 20px; border-radius: 6px; display: flex; align-items: center; padding: 0 10px;\n             font-size: 11.5px; font-weight: 700; color: #fff; font-family: var(--mono);\n             transition: width 1.1s cubic-bezier(.22,.8,.35,1); width: 0; white-space: nowrap; }\n  .cmp-bar.before { background: #c3cee2; color: #44506a; }\n  .cmp-bar.after { background: linear-gradient(90deg, #4f7bff, var(--blue)); }\n  .cmp-bar.after.teal { background: linear-gradient(90deg, #2ec4b6, var(--teal)); }\n  .cmp-bar.after.orange { background: linear-gradient(90deg, #ffb26b, var(--orange)); }\n\n  /* 优化卡片 */\n  .opt {\n    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);\n    box-shadow: var(--shadow); margin-bottom: 22px; overflow: hidden;\n  }\n  .opt .head { display: flex; align-items: center; gap: 14px; padding: 20px 26px; border-bottom: 1px solid var(--line); }\n  .opt .num {\n    width: 34px; height: 34px; border-radius: 10px; flex: 0 0 auto;\n    display: flex; align-items: center; justify-content: center;\n    font-weight: 800; font-size: 15px; color: #fff;\n    background: linear-gradient(135deg, var(--blue), #5b83ff);\n  }\n  .opt:nth-of-type(2) .num { background: linear-gradient(135deg, var(--teal), #2ec4b6); }\n  .opt:nth-of-type(3) .num { background: linear-gradient(135deg, var(--orange), #ffb26b); }\n  .opt:nth-of-type(4) .num { background: linear-gradient(135deg, var(--red), #ff8fb1); }\n  .opt .head h3 { font-size: 17px; font-weight: 800; }\n  .opt .head .badge {\n    margin-left: auto; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 999px;\n    background: var(--teal-soft); color: var(--teal);\n  }\n  .opt .body { padding: 22px 26px 26px; }\n  .opt .row { display: grid; grid-template-columns: 64px 1fr; gap: 14px; margin-bottom: 14px; }\n  .opt .row:last-child { margin-bottom: 0; }\n  .opt .row .k {\n    font-size: 12.5px; font-weight: 700; color: var(--ink-2);\n    background: #f1f4fa; border-radius: 8px; height: fit-content;\n    padding: 4px 10px; text-align: center; white-space: nowrap;\n  }\n  .opt .row .k.hot { background: var(--red-soft); color: var(--red); }\n  .opt .row .k.good { background: var(--teal-soft); color: var(--teal); }\n  .opt .row .v { font-size: 14px; color: var(--ink); }\n  .opt .row .v ul { margin: 2px 0 0 18px; }\n  .opt .row .v li { margin: 3px 0; }\n  code {\n    font-family: var(--mono); font-size: 12.5px; background: #f1f4fa;\n    padding: 2px 7px; border-radius: 6px; color: #33415c;\n  }\n  .num-hl { font-family: var(--mono); font-weight: 800; }\n  .num-hl.bad { color: var(--red); }\n  .num-hl.good { color: var(--teal); }\n\n  /* 表格 */\n  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }\n  th, td { text-align: left; padding: 11px 12px; border-bottom: 1px solid var(--line); }\n  th { font-size: 12.5px; color: var(--ink-2); font-weight: 700; background: #f8fafd; }\n  tr:last-child td { border-bottom: none; }\n  td.mono { font-family: var(--mono); font-size: 12.5px; }\n\n  .pill { display: inline-block; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 2px 10px; }\n  .pill.done { background: var(--teal-soft); color: var(--teal); }\n  .pill.pend { background: var(--orange-soft); color: var(--orange); }\n  .pill.hard { background: var(--red-soft); color: var(--red); }\n  .pill.soft { background: var(--orange-soft); color: var(--orange); }\n\n  /* 文件列表 */\n  .files { display: flex; flex-wrap: wrap; gap: 8px; }\n  .files code { font-size: 12px; }\n\n  /* 代码块 */\n  .codeblock {\n    background: #101728; color: #dbe4f5; border-radius: 12px; padding: 18px 20px;\n    font-family: var(--mono); font-size: 12.5px; line-height: 1.8; overflow-x: auto;\n    white-space: pre;\n  }\n  .codeblock .c1 { color: #7dd3fc; }\n  .codeblock .c2 { color: #86efac; }\n  .codeblock .c3 { color: #fca5a5; }\n  .codeblock .c4 { color: #94a3b8; }\n\n  /* 滚动渐入 */\n  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }\n  .reveal.visible { opacity: 1; transform: none; }\n\n  footer { padding: 56px 0 72px; text-align: center; color: var(--ink-3); font-size: 13px; }\n  footer .line { width: 56px; height: 3px; border-radius: 3px; margin: 0 auto 20px;\n                 background: linear-gradient(90deg, var(--blue), var(--teal)); opacity: .5; }\n\n  @media (max-width: 760px) {\n    .hero h1 { font-size: 30px; }\n    .kpis { grid-template-columns: repeat(2, 1fr); }\n    .grid3 { grid-template-columns: 1fr; }\n    .bar-row { grid-template-columns: 96px 1fr 64px; }\n    .opt .row { grid-template-columns: 1fr; gap: 6px; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"progress\" id=\"progress\"></div>\n\n<!-- ================= HERO ================= -->\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <span class=\"tag\">HARMONYOS · UI 自动化测试工具</span>\n    <h1>hmuitest 优化汇报<br><span class=\"grad\">从基线测量到 4 项体验优化</span></h1>\n    <p class=\"sub\">\n      不凭感觉优化：先真机实测把时间花在哪、输出多啰嗦量清楚，再按数据排序动手。\n      全部改动基于真机验证，每项都有前后对比数据。\n    </p>\n    <p class=\"meta\">设备 23EGK24531000023 · App com.cmcc.DigitalHome · 2026-10-08</p>\n\n    <div class=\"kpis\">\n      <div class=\"kpi k1\"><div class=\"v\">7.5s <small>→</small> 3.4s</div><div class=\"l\">back 返回耗时（-55%）</div></div>\n      <div class=\"kpi k2\"><div class=\"v\">1.83s</div><div class=\"l\">每步快照复用节省</div></div>\n      <div class=\"kpi k3\"><div class=\"v\">-21%</div><div class=\"l\">差异报告字符数</div></div>\n      <div class=\"kpi k4\"><div class=\"v\">4 / 4</div><div class=\"l\">优化项全部完成</div></div>\n    </div>\n  </div>\n</header>\n\n<div class=\"wrap\">\n\n  <!-- ================= 01 项目背景 ================= -->\n  <section id=\"about\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">01</span>\n      <h2>项目背景</h2>\n      <span class=\"note\">hmuitest 是什么</span>\n    </div>\n    <div class=\"grid3 reveal\">\n      <div class=\"mini\">\n        <div class=\"t\"><span class=\"dot\"></span>为 AI Agent 设计</div>\n        <p>区别于 Appium/pytest 的「确定性脚本」范式：每次操作自动输出机器可读裁决 + 页面状态 + 差异报告 + 断言对照（四层反馈），AI 逐步决策不盲走。</p>\n      </div>\n      <div class=\"mini\">\n        <div class=\"t\"><span class=\"dot\" style=\"background:var(--teal)\"></span>11 种裁决状态</div>\n        <p>SUCCESS / NO_CHANGE / BLOCKED_BY_DIALOG / CLICK_ON_DISABLED / BACK_INEFFECTIVE / CRASHED / RESTARTED …每种都带纠错建议，exit code 直接反映 pass/fail。</p>\n      </div>\n      <div class=\"mini\">\n        <div class=\"t\"><span class=\"dot\" style=\"background:var(--orange)\"></span>零依赖单入口</div>\n        <p>纯 Python 标准库 + hdc，约 1 万行 / 23 个模块。app / ui / tree / script / log / device 六个子命令分组，一套 CLI 覆盖调试、回归、探索全流程。</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= 02 工作过程 ================= -->\n  <section id=\"process\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">02</span>\n      <h2>工作过程</h2>\n      <span class=\"note\">调研 → 审查 → 测量 → 优化</span>\n    </div>\n    <div class=\"card reveal\">\n      <div class=\"timeline\">\n        <div class=\"tl-item\">\n          <div class=\"t\">调研：传统自动化对比 + GitHub 生态扫描</div>\n          <div class=\"d\">4 个 subagent 并行调研 <b>40+ 个低星但设计独特的项目</b>（hmdriver2、harmonyos-mcp、AgentProg、V-Droid、selfmend…），收敛出 8 个跨项目主题：元素引用代际校验、定位歧义打分、状态摘要、失败归因分类等。</div>\n        </div>\n        <div class=\"tl-item\">\n          <div class=\"t\">审查：3 路 subagent 红队评审原方案</div>\n          <div class=\"d\">从「代码可行性 / 红队攻击 / 真实工作流价值」三个角度交叉审查，<b>砍掉约一半过度设计</b>（ref 机制经济学不成立、0.9/0.05 阈值拍脑袋、知识库是更弱的 pytest…）。核心结论：<b>正确顺序是从瓶颈找方案，不是从项目找问题</b>。</div>\n        </div>\n        <div class=\"tl-item\">\n          <div class=\"t\">测量：真机基线实测</div>\n          <div class=\"d\">把「每步时间花在哪、输出多啰嗦」量清楚：单步 3.2s 中 <b>两次 dump 占 90%</b>；输出实测 26-52 行/步（并非传闻的 144 行）；构建 45.8s/轮是最大固定开销。</div>\n        </div>\n        <div class=\"tl-item\">\n          <div class=\"t\">优化：4 项按数据排序落地</div>\n          <div class=\"d\">back 耗时修复 · 快照复用验证 · 差异报告折叠 · 导航状态检查。每项真机验证，全部完成。</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= 03 基线测量 ================= -->\n  <section id=\"baseline\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">03</span>\n      <h2>基线测量</h2>\n      <span class=\"note\">真机实测数据</span>\n    </div>\n\n    <div class=\"card reveal\">\n      <h3 style=\"font-size:15.5px;margin-bottom:4px\">单步 ui 操作耗时构成（平均 3.2s）</h3>\n      <p style=\"font-size:13px;color:var(--ink-2);margin-bottom:18px\">瓶颈定位：<b>两次全量扫描（dump）占了约 90% 的时间</b>，Python / hdc / 桥接等基础开销合计不到 0.5s。</p>\n      <div class=\"bars\">\n        <div class=\"bar-row\"><span class=\"name\">after 扫描（dump）</span><div class=\"track\"><div class=\"fill\" data-w=\"53%\"></div></div><span class=\"val\">1.7s</span></div>\n        <div class=\"bar-row\"><span class=\"name\">裁决 / 输出</span><div class=\"track\"><div class=\"fill\" data-w=\"16%\"></div></div><span class=\"val\">0.5s</span></div>\n        <div class=\"bar-row\"><span class=\"name\">UI 稳定窗</span><div class=\"track\"><div class=\"fill\" data-w=\"12%\"></div></div><span class=\"val\">0.4s</span></div>\n        <div class=\"bar-row\"><span class=\"name\">before 复用</span><div class=\"track\"><div class=\"fill teal\" data-w=\"6%\"></div></div><span class=\"val\">0.2s</span></div>\n        <div class=\"bar-row\"><span class=\"name\">点击注入</span><div class=\"track\"><div class=\"fill teal\" data-w=\"3%\"></div></div><span class=\"val\">0.1s</span></div>\n        <div class=\"bar-row\"><span class=\"name\">其他</span><div class=\"track\"><div class=\"fill gray\" data-w=\"10%\"></div></div><span class=\"val\">0.3s</span></div>\n      </div>\n    </div>\n\n    <div class=\"card reveal\">\n      <h3 style=\"font-size:15.5px;margin-bottom:14px\">其他关键数据</h3>\n      <table>\n        <tr><th>项</th><th>数据</th><th>说明</th></tr>\n        <tr><td>单次 dump（设备端）</td><td class=\"mono\">1.25s</td><td>不带 <code>-a</code> 快路径；带 <code>-a</code> 慢路径 6.0s</td></tr>\n        <tr><td>Python 启动 + import</td><td class=\"mono\">0.07s</td><td>可忽略</td></tr>\n        <tr><td>桥接查询</td><td class=\"mono\">0.20s</td><td>可忽略</td></tr>\n        <tr><td>默认输出体积</td><td class=\"mono\">26-52 行</td><td>约 800-1800 字符/步；<code>--fast</code> 为 4 行/75 字符</td></tr>\n        <tr><td>增量构建（含安装启动）</td><td class=\"mono\">45.8s</td><td>每轮迭代最大固定开销</td></tr>\n        <tr><td>设备命令并发</td><td class=\"mono\">2.1s → 32.6s</td><td>uitest API 并发冲突，必须串行</td></tr>\n      </table>\n    </div>\n  </section>\n\n  <!-- ================= 04 优化 ================= -->\n  <section id=\"optimizations\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">04</span>\n      <h2>4 项优化</h2>\n      <span class=\"note\">每项均有前后对比验证</span>\n    </div>\n\n    <!-- 优化 1 -->\n    <div class=\"opt reveal\">\n      <div class=\"head\">\n        <div class=\"num\">1</div>\n        <h3>修复 back 偶发 7.5s：误判「内部重启」</h3>\n        <span class=\"badge\">7.5s → 3.4s</span>\n      </div>\n      <div class=\"body\">\n        <div class=\"row\"><span class=\"k hot\">问题</span><div class=\"v\">从 WebView 返回时偶发 <span class=\"num-hl bad\">7.51s</span>，是普通操作（3.2s）的 2.3 倍，且行为不稳定。</div></div>\n        <div class=\"row\"><span class=\"k\">根因</span><div class=\"v\">页面跳转销毁节点导致控件编号（accessibilityId）骤降，被检测逻辑误判为「App 内部重启」→ 触发 <b>0.8s 等待 + 第二次全量扫描复查</b>，白花约 2.5s。</div></div>\n        <div class=\"row\"><span class=\"k good\">修复</span><div class=\"v\">路由已确认变化时（跳转/返回成功），不再判「内部重启」——页面切换必然重建 UI，编号骤降是正常现象；真崩溃由进程/故障日志检查兜底。</div></div>\n        <div class=\"row\"><span class=\"k\">验证</span><div class=\"v\">\n          <div class=\"cmp\">\n            <div class=\"cmp-item\">\n              <div class=\"label\"><span>back 返回（WebView → MainPage）</span><b>7.5s → 3.4s</b></div>\n              <div class=\"cmp-track\">\n                <div class=\"cmp-bar before\" data-w=\"100%\">修复前 7.5s</div>\n                <div class=\"cmp-bar after\" data-w=\"45%\">修复后 3.4s</div>\n              </div>\n            </div>\n          </div>\n        </div></div>\n      </div>\n    </div>\n\n    <!-- 优化 2 -->\n    <div class=\"opt reveal\">\n      <div class=\"head\">\n        <div class=\"num\">2</div>\n        <h3>验证 after-state 复用：每步省 1.83s</h3>\n        <span class=\"badge\">已实现 · 验证生效</span>\n      </div>\n      <div class=\"body\">\n        <div class=\"row\"><span class=\"k\">背景</span><div class=\"v\">审查建议「评估跨命令快照复用」：连续操作时，上一步的扫描结果能否直接当下一步的对比基准？</div></div>\n        <div class=\"row\"><span class=\"k good\">结论</span><div class=\"v\">机制<b>早已实现</b>：默认自动复用上一步页面快照（条件是快照 2 分钟内且路由未变），无需新开发。</div></div>\n        <div class=\"row\"><span class=\"k\">验证</span><div class=\"v\">\n          <div class=\"cmp\">\n            <div class=\"cmp-item\">\n              <div class=\"label\"><span>默认（复用快照） vs --fresh-before（强制重新扫描）</span><b>每步省 1.83s</b></div>\n              <div class=\"cmp-track\">\n                <div class=\"cmp-bar before\" data-w=\"100%\">强制重新扫描 4.95s</div>\n                <div class=\"cmp-bar after teal\" data-w=\"63%\">默认复用 3.12s</div>\n              </div>\n            </div>\n          </div>\n        </div></div>\n      </div>\n    </div>\n\n    <!-- 优化 3 -->\n    <div class=\"opt reveal\">\n      <div class=\"head\">\n        <div class=\"num\">3</div>\n        <h3>差异报告折叠：修复「全员有信息量」bug</h3>\n        <span class=\"badge\">42 行 → 35 行 · 明细去噪</span>\n      </div>\n      <div class=\"body\">\n        <div class=\"row\"><span class=\"k hot\">问题</span><div class=\"v\">整页切换时报告列出「消失 122 条」全是 <code>NavDestination</code>、<code>Stack</code> 这类无文本空壳节点，占掉半屏输出，AI 需要的信息被淹没。</div></div>\n        <div class=\"row\"><span class=\"k\">根因</span><div class=\"v\">扫描工具给<b>所有</b>控件都带默认属性 <code>checked=false</code>（实测 297 个节点里 296 个），而报告逻辑把这个默认值当成「有信息量」——于是每个空壳节点都被当成有效变化。</div></div>\n        <div class=\"row\"><span class=\"k good\">修复</span><div class=\"v\">\n          <ul>\n            <li>「有信息量」判定修正：仅真实文本 / 勾选为真 / 状态类控件才算</li>\n            <li>纯结构节点折叠成一行：「另 N 条纯结构/无文本」</li>\n            <li>整页切换（变化 &gt;50 节点）时明细只列 4 条示例</li>\n            <li>复查时不再重复打印整份报告（此前输出翻倍）</li>\n          </ul>\n        </div></div>\n        <div class=\"row\"><span class=\"k\">对比</span><div class=\"v\">\n          <div class=\"cmp\">\n            <div class=\"cmp-item\">\n              <div class=\"label\"><span>整页切换场景输出体积</span><b>2311 → 1835 字符（-21%）</b></div>\n              <div class=\"cmp-track\">\n                <div class=\"cmp-bar before\" data-w=\"100%\">修复前 42 行 / 2311 字符</div>\n                <div class=\"cmp-bar after orange\" data-w=\"79%\">修复后 35 行 / 1835 字符</div>\n              </div>\n            </div>\n          </div>\n          <div style=\"margin-top:14px\" class=\"codeblock\"><span class=\"c4\">修复前（全是空壳节点）</span>\n● 消失(122) → 有信息量 122 条\n    - NavDestination(无文本)\n    - Navigation(无文本)\n    - NavBar(无文本)\n    <span class=\"c3\">… 另 115 条纯结构/无文本</span>\n\n<span class=\"c4\">修复后（真实文案 + 折叠）</span>\n● 消失(86) → 有信息量 29 条，另 57 条纯结构/无文本\n    - Text '杭州'\n    - Text '宠物驱虫'\n    <span class=\"c2\">… 另 25 条有信息量条目未显示</span></div>\n        </div></div>\n      </div>\n    </div>\n\n    <!-- 优化 4 -->\n    <div class=\"opt reveal\">\n      <div class=\"head\">\n        <div class=\"num\">4</div>\n        <h3>导航补状态检查：堵住「跳转成功但页面有坑」盲区</h3>\n        <span class=\"badge\">正常 1 行 · 异常才展开</span>\n      </div>\n      <div class=\"body\">\n        <div class=\"row\"><span class=\"k hot\">问题</span><div class=\"v\"><code>app navigate</code> 只输出一行「跳转成功」（19 字符），但路由跳过去 ≠ 页面能用：弹着权限弹窗、白屏未渲染、被踢下线——AI 不知道，下一步操作失败才发现。</div></div>\n        <div class=\"row\"><span class=\"k good\">修复</span><div class=\"v\">navigate / click-device / back / restart / login / logout 全部获得统一页面状态检查，复用已有扫描，<b>无额外耗时</b>：</div></div>\n        <div class=\"row\"><span class=\"k\">检查项</span><div class=\"v\">\n          <table>\n            <tr><th>检查项</th><th>级别</th><th>行为</th></tr>\n            <tr><td>弹窗未处理 / 白屏 / 被踢下线</td><td><span class=\"pill hard\">硬异常</span></td><td>警告 + FAILED，exit 1</td></tr>\n            <tr><td>加载中 / 错误文案</td><td><span class=\"pill soft\">软提醒</span></td><td>仅提示，不改变退出码</td></tr>\n          </table>\n        </div></div>\n        <div class=\"row\"><span class=\"k\">效果</span><div class=\"v\">正常时输出保持 1 行（实测 2.2s 不变）；异常才展开。踢线检查在 logout/restart/login 等「在登录页是预期」的场景自动跳过，不会误报。</div></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= 05 成果汇总 ================= -->\n  <section id=\"summary\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">05</span>\n      <h2>成果汇总</h2>\n      <span class=\"note\">全部真机验证</span>\n    </div>\n    <div class=\"card reveal\">\n      <table>\n        <tr><th>#</th><th>优化项</th><th>关键收益</th><th>状态</th></tr>\n        <tr><td class=\"mono\">1</td><td>back 误判「内部重启」修复</td><td class=\"mono\">7.5s → 3.4s（-55%）</td><td><span class=\"pill done\">完成</span></td></tr>\n        <tr><td class=\"mono\">2</td><td>after-state 复用验证</td><td class=\"mono\">每步省 1.83s（-37%）</td><td><span class=\"pill done\">完成</span></td></tr>\n        <tr><td class=\"mono\">3</td><td>差异报告折叠 + bug 修复</td><td class=\"mono\">-21% 字符 · 明细去噪</td><td><span class=\"pill done\">完成</span></td></tr>\n        <tr><td class=\"mono\">4</td><td>导航补页面状态检查</td><td class=\"mono\">堵盲区 · 正常零开销</td><td><span class=\"pill done\">完成</span></td></tr>\n      </table>\n    </div>\n    <div class=\"card reveal\">\n      <h3 style=\"font-size:15.5px;margin-bottom:12px\">修改文件（5 个）</h3>\n      <div class=\"files\">\n        <code>hmuitest.py</code>\n        <code>verdict.py</code>\n        <code>diff_engine.py</code>\n        <