ze: 52px; line-height: 1.15; letter-spacing: -.03em; font-weight: 800; font-family: var(--mono); }\n  .hero h1 .grad { background: linear-gradient(100deg, var(--blue), var(--teal));\n    -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .hero .sub { margin-top: 18px; font-size: 18px; color: var(--ink-2); max-width: 760px; }\n  .hero .sub b { color: var(--ink); }\n  .hero .meta { margin-top: 12px; font-size: 13px; color: var(--ink-3); font-family: var(--mono); }\n\n  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 40px; }\n  .kpi { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 18px 18px; box-shadow: var(--shadow); }\n  .kpi .v { font-size: 26px; font-weight: 800; letter-spacing: -.02em; font-family: var(--mono); }\n  .kpi .l { margin-top: 3px; font-size: 12.5px; color: var(--ink-2); }\n  .kpi.k1 .v { color: var(--blue); }\n  .kpi.k2 .v { color: var(--teal); }\n  .kpi.k3 .v { color: var(--orange); }\n  .kpi.k4 .v { color: var(--violet); }\n\n  /* ===== Section ===== */\n  section { padding: 44px 0 6px; }\n  .sec-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 22px; }\n  .sec-no { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--blue);\n    background: var(--blue-soft); border-radius: 8px; padding: 4px 10px; }\n  .sec-head h2 { font-size: 27px; letter-spacing: -.015em; font-weight: 800; }\n  .sec-head .note { font-size: 13px; color: var(--ink-3); margin-left: auto; }\n  .sec-lead { font-size: 15px; color: var(--ink-2); margin: -10px 0 22px; max-width: 780px; }\n  .sec-lead b { color: var(--ink); }\n\n  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 26px 28px; box-shadow: var(--shadow); margin-bottom: 18px; }\n\n  /* ===== 痛点 → 回答 ===== */\n  .pain { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\n  .pain-item { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);\n    box-shadow: var(--shadow); overflow: hidden; }\n  .pain-item .p { padding: 16px 20px; background: #fbfcfe; border-bottom: 1px dashed var(--line);\n    display: flex; gap: 10px; align-items: flex-start; }\n  .pain-item .p .x { flex: 0 0 auto; width: 22px; height: 22px; border-radius: 7px;\n    background: var(--red-soft); color: var(--red); font-weight: 800; font-size: 12px;\n    display: flex; align-items: center; justify-content: center; margin-top: 2px; }\n  .pain-item .p .tx { font-size: 14px; font-weight: 700; }\n  .pain-item .p .tx span { display: block; font-weight: 400; font-size: 12.5px; color: var(--ink-2); margin-top: 2px; }\n  .pain-item .a { padding: 16px 20px; display: flex; gap: 10px; align-items: flex-start; }\n  .pain-item .a .ok { flex: 0 0 auto; width: 22px; height: 22px; border-radius: 7px;\n    background: var(--teal-soft); color: var(--teal); font-weight: 800; font-size: 12px;\n    display: flex; align-items: center; justify-content: center; margin-top: 2px; }\n  .pain-item .a .tx { font-size: 13.5px; color: var(--ink-2); }\n  .pain-item .a .tx b { color: var(--ink); }\n  .pain-item .a .tx code { font-size: 12px; }\n\n  /* ===== 终端 ===== */\n  .term { background: #0e1524; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 50px -24px rgba(14,21,36,.55); }\n  .term .bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; background: #131c30; }\n  .term .bar i { width: 11px; height: 11px; border-radius: 50%; display: block; }\n  .term .bar i:nth-child(1) { background: #ff5f57; }\n  .term .bar i:nth-child(2) { background: #febc2e; }\n  .term .bar i:nth-child(3) { background: #28c840; }\n  .term .bar span { margin-left: 8px; font-family: var(--mono); font-size: 11.5px; color: #64748b; }\n  .term pre { padding: 20px 22px; font-family: var(--mono); font-size: 12.5px;\n    line-height: 1.85; color: #dbe4f5; overflow-x: auto; white-space: pre; }\n  .c-cmd { color: #7dd3fc; }\n  .c-ok { color: #86efac; }\n  .c-warn { color: #fbbf24; }\n  .c-dim { color: #64748b; }\n  .c-err { color: #fca5a5; }\n  .c-key { color: #c4b5fd; }\n\n  /* ===== 能力卡片 ===== */\n  .grid-cap { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }\n  .cap { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 20px; box-shadow: var(--shadow); transition: transform .25s ease, box-shadow .25s ease; }\n  .cap:hover { transform: translateY(-3px); box-shadow: 0 14px 34px -16px rgba(24,35,58,.22); }\n  .cap .ico { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center;\n    justify-content: center; margin-bottom: 12px; }\n  .cap .ico svg { width: 19px; height: 19px; }\n  .cap h4 { font-size: 14.5px; font-weight: 800; margin-bottom: 5px; }\n  .cap p { font-size: 12.5px; color: var(--ink-2); line-height: 1.65; }\n  .cap p code { font-size: 11.5px; }\n  .ic-blue { background: var(--blue-soft); color: var(--blue); }\n  .ic-teal { background: var(--teal-soft); color: var(--teal); }\n  .ic-orange { background: var(--orange-soft); color: var(--orange); }\n  .ic-violet { background: var(--violet-soft); color: var(--violet); }\n  .ic-red { background: var(--red-soft); color: var(--red); }\n\n  /* ===== 表格 ===== */\n  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }\n  th, td { text-align: left; padding: 11px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }\n  th { font-size: 12.5px; color: var(--ink-2); font-weight: 700; background: #f8fafd; }\n  tr:last-child td { border-bottom: none; }\n  td.mono { font-family: var(--mono); font-size: 12.5px; white-space: nowrap; }\n\n  code { font-family: var(--mono); font-size: 12.5px; background: #f1f4fa;\n    padding: 2px 7px; border-radius: 6px; color: #33415c; }\n  .codeblock { background: #0e1524; color: #dbe4f5; border-radius: 12px; padding: 18px 20px;\n    font-family: var(--mono); font-size: 12.5px; line-height: 1.9; overflow-x: auto; white-space: pre; }\n  .codeblock .c-cmd { color: #7dd3fc; }\n  .codeblock .c-dim { color: #64748b; }\n  .codeblock .c-ok { color: #86efac; }\n\n  /* 数据条 */\n  .bars { display: flex; flex-direction: column; gap: 11px; }\n  .bar-row { display: grid; grid-template-columns: 150px 1fr 74px; gap: 12px; align-items: center; }\n  .bar-row .name { font-size: 13px; color: var(--ink-2); text-align: right; }\n  .bar-row .track { height: 24px; background: #eef2f9; border-radius: 8px; overflow: hidden; }\n  .bar-row .fill { height: 100%; border-radius: 8px; width: 0;\n    transition: width 1s cubic-bezier(.22,.8,.35,1);\n    background: linear-gradient(90deg, #4f7bff, var(--blue)); }\n  .bar-row .val { font-family: var(--mono); font-size: 13px; font-weight: 700; }\n  .fill.teal { background: linear-gradient(90deg, #2ec4b6, var(--teal)); }\n  .fill.gray { background: linear-gradient(90deg, #b9c5da, #8fa1bd); }\n\n  /* 裁决闭环 pills */\n  .loop { display: flex; flex-wrap: wrap; gap: 8px; }\n  .pill { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700;\n    border-radius: 999px; padding: 5px 13px; border: 1px solid transparent; }\n  .pill .d { width: 7px; height: 7px; border-radius: 50%; }\n  .pill.ok { background: var(--teal-soft); color: #0b7a70; }\n  .pill.ok .d { background: var(--teal); }\n  .pill.soft { background: var(--orange-soft); color: #b64a0b; }\n  .pill.soft .d { background: var(--orange); }\n  .pill.hard { background: var(--red-soft); color: #b02a5b; }\n  .pill.hard .d { background: var(--red); }\n  .pill.info { background: var(--blue-soft); color: var(--blue); }\n  .pill.info .d { background: var(--blue); }\n\n  /* 步骤 */\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; counter-reset: step; }\n  .step { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 20px; box-shadow: var(--shadow); position: relative; }\n  .step .no { font-family: var(--mono); font-weight: 800; font-size: 13px; color: var(--blue);\n    background: var(--blue-soft); width: 28px; height: 28px; border-radius: 9px;\n    display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }\n  .step h4 { font-size: 14.5px; font-weight: 800; margin-bottom: 5px; }\n  .step p { font-size: 12.5px; color: var(--ink-2); }\n  .step p code { font-size: 11.5px; }\n\n  /* 架构 */\n  .arch { display: grid; grid-template-columns: 250px 1fr; gap: 22px; align-items: start; }\n  .arch-tree { font-family: var(--mono); font-size: 12px; line-height: 2; color: #33415c;\n    background: #f8fafd; border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; white-space: pre; }\n  .arch-tree .hl { color: var(--blue); font-weight: 700; }\n  .arch-tree .dim { color: var(--ink-3); }\n  .principles { display: flex; flex-direction: column; gap: 10px; }\n  .principle { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; }\n  .principle .n { flex: 0 0 auto; width: 20px; height: 20px; border-radius: 6px; margin-top: 3px;\n    background: var(--blue-soft); color: var(--blue); font-size: 11px; font-weight: 800;\n    display: flex; align-items: center; justify-content: center; }\n  .principle b { color: var(--ink); }\n  .principle span { color: var(--ink-2); }\n\n  /* 文档导航 */\n  .docs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }\n  .doc { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 18px 20px; box-shadow: var(--shadow); }\n  .doc .f { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--blue); }\n  .doc p { font-size: 12.5px; color: var(--ink-2); margin-top: 4px; }\n\n  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }\n  .reveal.visible { opacity: 1; transform: none; }\n\n  footer { padding: 56px 0 72px; text-align: center; color: var(--ink-3); font-size: 13px; }\n  footer .line { width: 56px; height: 3px; border-radius: 3px; margin: 0 auto 20px;\n    background: linear-gradient(90deg, var(--blue), var(--teal)); opacity: .5; }\n\n  @media (max-width: 820px) {\n    .hero h1 { font-size: 34px; }\n    .kpis { grid-template-columns: repeat(2, 1fr); }\n    .pain, .grid-cap, .steps, .docs { grid-template-columns: 1fr; }\n    .arch { grid-template-columns: 1fr; }\n    .bar-row { grid-template-columns: 96px 1fr 64px; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"progress\" id=\"progress\"></div>\n\n<!-- ================= HERO ================= -->\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <span class=\"tag\">HARMONYOS · AI-NATIVE UI TESTING</span>\n    <h1>hmui<span class=\"grad\">test</span></h1>\n    <p class=\"sub\">\n      为 <b>AI Agent</b> 设计的 HarmonyOS UI 自动化测试工具。<br>\n      一条命令 = UI 操作 + 差异报告 + 页面状态 + 机器可读裁决 —— 让 AI 测试 App <b>每一步都看得见，不盲走</b>。\n    </p>\n    <p class=\"meta\">python3 hmuitest.py · 纯 Python 标准库 + hdc · 零第三方依赖</p>\n\n    <div class=\"kpis\">\n      <div class=\"kpi k1\"><div class=\"v\">6</div><div class=\"l\">子命令（app/ui/tree/script/log/device）</div></div>\n      <div class=\"kpi k2\"><div class=\"v\">11</div><div class=\"l\">种机器可读裁决状态</div></div>\n      <div class=\"kpi k3\"><div class=\"v\">~3.2s</div><div class=\"l\">单步操作（含两次全量扫描）</div></div>\n      <div class=\"kpi k4\"><div class=\"v\">0</div><div class=\"l\">第三方依赖</div></div>\n    </div>\n  </div>\n</header>\n\n<div class=\"wrap\">\n\n  <!-- ================= 01 为什么 ================= -->\n  <section id=\"why\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">01</span>\n      <h2>AI 测试 App，难在哪？</h2>\n      <span class=\"note\">四个真实痛点与对应设计</span>\n    </div>\n    <div class=\"pain\">\n      <div class=\"pain-item reveal\">\n        <div class=\"p\"><span class=\"x\">✕</span><div class=\"tx\">控件树太大，token 爆炸<span>一页 300+ 节点、20 万字符，直接喂给模型既贵又容易被噪声淹没</span></div></div>\n        <div class=\"a\"><span class=\"ok\">✓</span><div class=\"tx\"><b>紧凑输出 + 智能差异折叠</b>：只报「有信息量」的变化，纯结构节点折叠成一行；<code>--fast</code> 模式输出仅 4 行/75 字符</div></div>\n      </div>\n      <div class=\"pain-item reveal\">\n        <div class=\"p\"><span class=\"x\">✕</span><div class=\"tx\">操作完，不知道生效没有<span>点击了、输入了，然后呢？页面变没变、变对没有，全靠再查一遍</span></div></div>\n        <div class=\"a\"><span class=\"ok\">✓</span><div class=\"tx\"><b>四层反馈</b>：每次操作自动输出 裁决 + 页面状态 + 差异报告 + 断言对照，一行 <code>ACTION_VERDICT</code> 直接给结论</div></div>\n      </div>\n      <div class=\"pain-item reveal\">\n        <div class=\"p\"><span class=\"x\">✕</span><div class=\"tx\">失败了，不知道为什么、下一步干嘛<span>异常堆栈对 AI 不友好，只能瞎猜重试，容易把状态越搞越乱</span></div></div>\n        <div class=\"a\"><span class=\"ok\">✓</span><div class=\"tx\"><b>裁决纠错闭环</b>：11 种状态每种都配 <code>reason</code> + <code>suggestion</code>，并有标准应对表（防双翻转、三振止损）</div></div>\n      </div>\n      <div class=\"pain-item reveal\">\n        <div class=\"p\"><span class=\"x\">✕</span><div class=\"tx\">弹窗/白屏/踢线，卡死循环<span>权限弹窗挡住点击、页面白屏找不到控件、被踢下线还继续操作</span></div></div>\n        <div class=\"a\"><span class=\"ok\">✓</span><div class=\"tx\"><b>弹窗自愈 + 页面状态检查</b>：被挡自动清理重试一次；导航后自动检查弹窗/白屏/踢线，异常才展开警告</div></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= 02 四层反馈 ================= -->\n  <section id=\"feedback\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">02</span>\n      <h2>一次操作，四层反馈</h2>\n      <span class=\"note\">零参数，自动输出</span>\n    </div>\n    <p class=\"sec-lead reveal\">每次 <code>ui</code> 操作（点击/输入/滑动/返回）都会自动返回四层结构化反馈，AI 直接消费，不需要额外命令去「查一下」。</p>\n    <div class=\"term reveal\">\n      <div class=\"bar\"><i></i><i></i><i></i><span>hmuitest.py ui click-by-text \"设置\" --expect-route \"SettingsPage\"</span></div>\n      <pre><span class=\"c-cmd\">执行: 点击设置</span>\n<span class=\"c-ok\">✅ 点击设置 执行完成</span>\n\n<span class=\"c-key\">🧭 组件树变化</span>   新增 86 · 消失 99 · 位置变化 0 · 遮挡 0\n  ● 新增(86)  →  有信息量 29 条，另 57 条纯结构/无文本\n      + Text '杭州'  [32,166][130,223]\n      + Text '业务办理'  [73,444][230,499]\n      <span class=\"c-dim\">… 另 25 条有信息量条目未显示</span>\n  ● 消失(99)  →  有信息量 28 条，另 71 条纯结构/无文本\n      - Text '自动化'\n      <span class=\"c-dim\">…</span>\n<span class=\"c-dim\">PAGE_RESULT: CHANGES_DETECTED</span>\n\n<span class=\"c-ok\">✅ ACTION_VERDICT: SUCCESS | reason=检测到 185 处控件变化</span>          <span class=\"c-dim\">← 第 1 层：机器可读裁决</span>\n<span class=\"c-cmd\">📄 控件树 JSON: ~/.hmuitest/logs/dump/20261008/181034-layout.json</span>  <span class=\"c-dim\">← 复核直接解析，免二次扫描</span>\n\n<span class=\"c-key\">📋 当前页面状态 (CURRENT_PAGE_STATE)</span>                          <span class=\"c-dim\">← 第 2 层：页面实况</span>\n  📍 路由: route=MainPage\n  🪟 弹窗: 无\n  🔘 状态控件/输入框: 无变化\n  <span class=\"c-dim\">（另有 Toast / 开关实际值 / 输入框内容 / 错误文案 / 白屏·踢线警告）</span></pre>\n    </div>\n    <div class=\"card reveal\" style=\"margin-top:18px\">\n      <h3 style=\"font-size:15px;margin-bottom:12px\">裁决纠错闭环（节选）—— 意外情况的标准应对，禁止盲目重试</h3>\n      <div class=\"loop\">\n        <span class=\"pill ok\"><span class=\"d\"></span>SUCCESS → 继续下一步</span>\n        <span class=\"pill info\"><span class=\"d\"></span>NO_CHANGE → 复核实际状态再决定</span>\n        <span class=\"pill soft\"><span class=\"d\"></span>BLOCKED_BY_DIALOG → 清弹窗重试一次</span>\n        <span class=\"pill hard\"><span class=\"d\"></span>CLICK_ON_DISABLED → 勿重试，查锁定态</span>\n        <span class=\"pill hard\"><span class=\"d\"></span>CRASHED / RESTARTED → app restart 恢复</span>\n        <span class=\"pill soft\"><span class=\"d\"></span>BACK_INEFFECTIVE → 改 navigate 目标页</span>\n        <span class=\"pill hard\"><span class=\"d\"></span>BRIDGE_UNREACHABLE → 重启 App 或等 3s</span>\n        <span class=\"pill info\"><span class=\"d\"></span>DEVICE_IN_USE → 停止等待，勿抢设备</span>\n        <span class=\"pill info\"><span class=\"d\"></span>…共 11 种，全表见 SKILL.md</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= 03 核心能力 ================= -->\n  <section id=\"capabilities\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">03</span>\n      <h2>核心能力</h2>\n      <span class=\"note\">覆盖「操作 → 验证 → 回归」全流程</span>\n    </div>\n    <div class=\"grid-cap\">\n      <div class=\"cap reveal\"><div class=\"ico ic-blue\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 6h16M4 12h16M4 18h10\"/></svg></div>\n        <h4>四层反馈</h4><p>裁决 + 页面状态 + 差异报告 + 断言对照，每次操作自动输出，AI 零参数消费。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-teal\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a9 9 0 1 1-3-6.7\"/><path d=\"M21 3v6h-6\"/></svg></div>\n        <h4>裁决纠错闭环</h4><p>11 种裁决状态带纠错建议；防双翻转、三振止损、恢复协议写入 AI 行为约束。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-orange\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"3\" y=\"5\" width=\"7\" height=\"14\" rx=\"1.5\"/><rect x=\"14\" y=\"5\" width=\"7\" height=\"14\" rx=\"1.5\"/></svg></div>\n        <h4>智能差异报告</h4><p>操作前后控件树 diff：有信息量的变化 + 纯结构折叠 + 整页切换压缩，噪声自动降噪。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-blue\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></div>\n        <h4>断言内建</h4><p><code>--expect-route/text/state/dialog</code> 带轮询，exit code 直接反映 pass/fail，慢加载不误报。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-violet\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7\"/><path d=\"M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7\"/></svg></div>\n        <h4>桥接导航</h4><p>TcpBridge 直连 App：<code>app navigate</code> / <code>click-device</code> / 登录管理，跳转即验证路由。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-teal\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><circle cx=\"12\" cy=\"12\" r=\"1\" fill=\"currentColor\"/></svg></div>\n        <h4>语义定位</h4><p><code>click-by-text</code> / <code>click-by-id</code> 自动 dump→匹配→坐标点击，无需手算坐标。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-orange\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M8 6h13M8 12h13M8 18h13\"/><circle cx=\"3.5\" cy=\"6\" r=\"1\" fill=\"currentColor\"/><circle cx=\"3.5\" cy=\"12\" r=\"1\" fill=\"currentColor\"/><circle cx=\"3.5\" cy=\"18\" r=\"1\" fill=\"currentColor\"/></svg></div>\n        <h4>批量脚本 + 录制</h4><p><code>script run cases.json</code> 多步用例一键执行；<code>script record</code> 录操作回放；每步复用快照省一半扫描。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-blue\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 3h6v5l4 9a2 2 0 0 1-1.8 3H6.8A2 2 0 0 1 5 17l4-9V3z\"/><path d=\"M7.5 14h9\"/></svg></div>\n        <h4>pytest 集成</h4><p><code>scripts/conftest_template.py</code> 提供 fixture / hook 模板，稳定回归集直接跑 pytest。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-red\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></svg></div>\n        <h4>跨会话设备锁</h4><p>多 Agent 共享设备防互拆（uitest API 并发会静默失效）；TTL 过期自动接替。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-violet\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12h4l2.5-7 4 14 2.5-7h5\"/></svg></div>\n        <h4>崩溃 / 重启检测</h4><p>进程存活 + 故障日志 + 控件编号基线三重检测，<code>CRASHED</code> / <code>RESTARTED</code> 自动识别。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-orange\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 8h3l2-3h6l2 3h3v11H4z\"/><circle cx=\"12\" cy=\"13\" r=\"3.5\"/></svg></div>\n        <h4>失败留证</h4><p>失败自动截屏 + 抓 hilog + 归档控件树 JSON，证据链一次到位，免手工拼命令。</p></div>\n      <div class=\"cap reveal\"><div class=\"ico ic-teal\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 2 4 14h6l-1 8 9-12h-6z\"/></svg></div>\n        <h4>快照复用（省 1.8s/步）</h4><p>连续操作时上一步的扫描结果直接作为下一步基准（2 分钟内 + 路由未变），每步省一次全量扫描。</p></div>\n    </div>\n  </section>\n\n  <!-- ================= 04 快速上手 ================= -->\n  <section id=\"start\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">04</span>\n      <h2>快速上手</h2>\n      <span class=\"note\">三条命令开始测试</span>\n    </div>\n    <div class=\"steps reveal\">\n      <div class=\"step\"><div class=\"no\">1</div><h4>准备环境</h4><p>macOS / Linux，Python 3.x；<code>hdc list targets</code> 能看到设备；被测 App 已安装（默认 <code>com.cmcc.DigitalHome</code>，可配置）。</p></div>\n      <div class=\"step\"><div class=\"no\">2</div><h4>跑第一条命令</h4><p><code>python3 hmuitest.py app navigate \"MainPage\"</code> 跳转目标页，桥接直连，跳转即验证。</p></div>\n      <div class=\"step\"><div class=\"no\">3</div><h4>操作 + 断言</h4><p><code>ui click-by-text \"设置\" --expect-route \"SettingsPage\"</code>，exit code 直接反映结果，可接 CI。</p></div>\n    </div>\n    <div class=\"codeblock reveal\" style=\"margin-top:16px\"><span class=\"c-dim\"># 常用操作一览</span>\n<span class=\"c-cmd\">python3 hmuitest.py app navigate \"MainPage\"</span>                    <span class=\"c-dim\"># 桥接导航（含路由验证）</span>\n<span class=\"c-cmd\">python3 hmuitest.py ui click 540 550 --operation \"点击登录\"</span>       <span class=\"c-dim\"># 坐标点击（自动四层反馈）</span>\n<span class=\"c-cmd\">python3 hmuitest.py ui click-by-text \"设置\" --expect-route \"SettingsPage\"</span>  <span class=\"c-dim\"># 语义点击 + 断言</span>\n<span class=\"c-cmd\">python3 hmuitest.py ui input \"hello\" --clear</span>                      <span class=\"c-dim\"># 输入（防残留拼接）</span>\n<span class=\"c-cmd\">python3 hmuitest.py script run cases.json</span>                          <span class=\"c-dim\"># 多步用例批量执行</span>\n<span class=\"c-cmd\">python3 hmuitest.py log grab --fault</span>                               <span class=\"c-dim\"># 抓崩溃堆栈</span>\n<span class=\"c-cmd\">python3 hmuitest.py --fast ui click ...</span>                            <span class=\"c-dim\"># 批量回归静默模式（4 行输出）</span>\n\n<span class=\"c-dim\"># 指定设备；桥接命令自动检测设备（env → session 文件 → hdc list targets）</span>\n<span class=\"c-cmd\">python3 hmuitest.py --device &lt;ID&gt; ui click 540 550</span></div>\n  </section>\n\n  <!-- ================= 05 命令体系 ================= -->\n  <section id=\"commands\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">05</span>\n      <h2>命令体系</h2>\n      <span class=\"note\">六个子命令，parse 时互斥校验</span>\n    </div>\n    <div class=\"card reveal\">\n      <table>\n        <tr><th>子命令</th><th>核心能力</th><th>典型场景</th></tr>\n        <tr><td class=\"mono\">app</td><td>页面导航、登录管理、设备查询、熄屏唤醒（TcpBridge 直连 App）</td><td>快速跳转目标页面</td></tr>\n        <tr><td class=\"mono\">aa</td><td>Deep Link 显式启动（aa start）</td><td>跳转指定 URI</td></tr>\n        <tr><td class=\"mono\">ui</td><td>点击/滑动/输入/返回 + 断言；snapshot / screenshot / collect（滚动收集计数）</td><td>执行 UI 操作并验证</td></tr>\n        <tr><td class=\"mono\">tree</td><td>控件树搜索、差异比较（本地文件 / 远程 dump）</td><td>分析 UI 状态、复核变化</td></tr>\n        <tr><td class=\"mono\">script</td><td>批量脚本执行 + UI 操作录制回放</td><td>跑完整测试流程</td></tr>\n        <tr><td class=\"mono\">log</td><td>hilog / 故障日志抓取（设备侧落盘 + 超时保护）</td><td>排查问题、抓崩溃堆栈</td></tr>\n        <tr><td class=\"mono\">device</td><td>跨会话设备占用声明（TTL 过期自动接替）</td><td>多会话共享设备</td></tr>\n      </table>\n    </div>\n  </section>\n\n  <!-- ================= 06 给 AI 工具接入 ================= -->\n  <section id=\"ai\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">06</span>\n      <h2>接入你的 AI 编码工具</h2>\n      <span class=\"note\">Skill 形态 · 渐进披露</span>\n    </div>\n    <p class=\"sec-lead reveal\">整个工具以 <b>Agent Skill</b> 形态组织：AI 工具（opencode / Claude Code 等）读取 <code>SKILL.md</code> 即获得完整的测试能力与行为约束，按需加载细节文档，不会一次性塞爆上下文。</p>\n    <div class=\"grid-cap reveal\" style=\"grid-template-columns:repeat(3,1fr)\">\n      <div class=\"cap\"><div class=\"ico ic-blue\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/></svg></div>\n        <h4>SKILL.md · 入口</h4><p>AI 行为约束（禁止盲操作）、裁决纠错闭环、决策树（什么任务走哪条命令）。</p></div>\n      <div class=\"cap\"><div class=\"ico ic-teal\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 4h16v16H4z\"/><path d=\"M8 8h8M8 12h8M8 16h5\"/></svg></div>\n        <h4>REFERENCE.md · 细节</h4><p>完整命令参数、注意事项、实测坑（如 IME 吞字符、软键盘坐标刷新）。</p></div>\n      <div class=\"cap\"><div class=\"ico ic-orange\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8\"/></svg></div>\n        <h4>EXAMPLES.md · 工作流</h4><p>完整测试工作流，含 subagent 探索 → 生成 pytest 回归脚本的流程。</p></div>\n    </div>\n    <div class=\"card reveal\" style=\"margin-top:16px\">\n      <h3 style=\"font-size:15px;margin-bottom:10px\">两种使用方式</h3>\n      <table>\n        <tr><th>方式</th><th>适合</th><th>入口</th></tr>\n        <tr><td><b>AI 对话驱动</b></td><td>探索、调试、功能验收：AI 逐步操作，每步消费四层反馈决策</td><td class=\"mono\">把 skill 装进 opencode / Claude Code，直接说需求</td></tr>\n        <tr><td><b>pytest 回归</b></td><td>稳定用例集：CI 里跑，exit code 门禁</td><td class=\"mono\">pytest tests/uitest/ -v（conftest 模板已提供）</td></tr>\n      </table>\n    </div>\n  </section>\n\n  <!-- ================= 07 架构 ================= -->\n  <section id=\"arch\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-no\">07</span>\n      <h2>架构与设计原则</h2>\n      <span class=\"note\">约 1 万行 · 23 个模块</span>\n    </div>\n    <div class=\"card reveal\">\n      <div class=\"arch\">\n        <div class=\"arch-tree\"><span class=\"hl\">hmuitest.py</span>          <span class=\"dim\"># 统一 CLI 入口</span>\n├── <span class=\"hl\">verdict.py</span>         <span class=\"dim\"># 统一裁决层</span>\n├── <span class=\"hl\">engine/</span>\n│   ├── helpers.py     <span class=\"dim\"># 公共层</span>\n│   ├── hdc_engine.py  <span class=\"dim\"># 坐标引擎</span>\n│   ├── semantic_engine.py <span class=\"dim\"># 语义定位</span>\n│   └── batch_runner.py    <span class=\"dim\"># 批量执行</span>\n├── <span class=\"hl\">diff_engine.py</span>     <span class=\"dim\"># 差异引擎</span>\n├── crash_detector.py  <span class=\"dim\"># 崩溃检测</span>\n├── tcp_bridge.py      <span class=\"dim\"># App 桥接</span>\n├── device_lock.py     <span class=\"dim\"># 设备锁</span>\n├── artifacts.py       <span class=\"dim\"># 失败留证</span>\n└── scripts/\n    ├── conftest_template.py <span class=\"dim\"># pytest 集成</span>\n    └── regression_loop.py   <span class=\"dim\"># 回归循环</span></div>\n        <div class=\"principles\">\n          <div class=\"principle\"><span class=\"n\">1</span><div><b>独立短进程</b>：每条命令都是独立进程，跨命令状态只能落盘 —— 没有常驻服务，崩溃不互相影响。</div></div>\n          <div class=\"principle\"><span class=\"n\">2</span><div><b>零第三方依赖</b>：纯 Python 标准库 + <code>hdc</code>，<code>requirements.txt</code> 为空 —— 部署即拷贝，没有环境腐化。</div></div>\n          <div class=\"principle\"><span class=\"n\">3</span><div><b>模块单向依赖</b>：CLI → 引擎 → 公共层，无循环依赖 —— 单文件可读、可测、可替换。</div></div>\n          <div class=\"principle\"><span class=\"n\">4</span><div><b>机器可读优先</b>：所有关键结论都有稳定的文本契约（<code>A